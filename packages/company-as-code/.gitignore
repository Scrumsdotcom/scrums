runtime.db
runtime.db-journal
runtime.db-wal
runtime.db-shm
runtime/runtime.db*

# Generated outputs are committed, do not ignore /generated
# (CI's drift gate depends on them being in version control)

# Branch-local working material. Deleted with the branch; never merged.
/.branch-workspace/
