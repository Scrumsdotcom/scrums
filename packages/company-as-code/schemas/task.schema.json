{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company-as-code.dev/schemas/v1alpha1/task.schema.json",
  "title": "Task",
  "description": "Canonical unit of execution. Tasks are state machines with typed transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "title", "state", "owner"],
  "properties": {
    "apiVersion": { "type": "string", "const": "company-as-code/v1alpha1" },
    "kind": { "type": "string", "const": "Task" },
    "id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9]+-[0-9]{4,}$",
      "description": "Canonical task ID, e.g. TASK-FIN-0042. Module prefix is opaque."
    },
    "title": { "type": "string", "minLength": 4 },
    "description": { "type": "string" },
    "module": {
      "type": "string",
      "description": "Owning module path.",
      "x-cac-ref": ["Manifest"]
    },
    "state": {
      "type": "string",
      "enum": ["backlog", "planned", "active", "blocked", "review", "completed", "archived", "failed"]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["person", "agent", "team"] },
        "id": { "type": "string" }
      }
    },
    "priority": { "type": "string", "enum": ["p0", "p1", "p2", "p3"] },
    "dueAt": { "type": "string", "format": "date-time" },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "respondWithin": { "type": "string", "description": "ISO 8601 duration." },
        "resolveWithin": { "type": "string", "description": "ISO 8601 duration." }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-[A-Z0-9]+-[0-9]{4,}$" },
      "default": []
    },
    "subtasks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-[A-Z0-9]+-[0-9]{4,}$" },
      "default": []
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after": { "type": "string", "description": "ISO 8601 duration before escalation." },
        "to": { "type": "string" }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow": { "type": "string", "x-cac-ref": ["Workflow"] },
        "agent": { "type": "string", "x-cac-ref": ["Agent"] },
        "trigger": { "type": "string" }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role"],
        "properties": {
          "role": { "type": "string" },
          "actor": { "type": "string" },
          "decidedAt": { "type": "string", "format": "date-time" },
          "decision": { "type": "string", "enum": ["approved", "rejected", "pending"] }
        }
      },
      "default": []
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "at"],
        "properties": {
          "state": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "default": []
    }
  }
}
