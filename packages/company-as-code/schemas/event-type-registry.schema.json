{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company-as-code.dev/schemas/event-type-registry.schema.json",
  "title": "Event Type Registry",
  "description": "The enum-controlled registry of typed event names. One document for the company. Adding a new type requires a schema migration and an ADR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "version", "events"],
  "properties": {
    "apiVersion": { "type": "string", "const": "company-as-code/v1" },
    "kind": { "type": "string", "const": "EventTypeRegistry" },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Registry schema version. Bumped only via ADR + migration."
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description", "emittingModule", "status"],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$",
            "description": "Dotted, lowercase + snake_case. Leading segment is the emitting domain or module."
          },
          "description": { "type": "string", "minLength": 8 },
          "emittingModule": { "type": "string" },
          "payloadSchema": {
            "type": "string",
            "description": "Optional repo-relative path to the JSON-Schema-flavoured payload definition."
          },
          "status": {
            "type": "string",
            "enum": ["experimental", "stable", "deprecated"]
          },
          "deprecatedAt": { "type": "string", "format": "date" },
          "removeAfter": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
