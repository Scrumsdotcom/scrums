{
  "$schema": "https://design-tokens.org/schema.json",
  "_meta": {
    "system": "Scrums.com Console / Field-Ops",
    "version": "1.1",
    "note": "hex is the Figma mirror of the oklch source; change both together. Names are px-valued for spacing (space-16 = 16px).",
    "collections": {
      "primitive": "Primitives",
      "theme": "Theme (modes: light/dark/blue)",
      "surface": "Constant Surfaces (no modes)"
    }
  },
