  "state": {
    "_note": "Express as Figma component variants / CSS pseudo. Treatment only \u2014 no shadow/scale/glow.",
    "button-primary": {
      "default": "{primitive.blue.500}",
      "hover": "{primitive.blue.600}",
      "press": "translateY(1px)",
      "focus": "2px {primitive.blue.500} offset 2px",
      "disabled": "opacity 0.45"
    },
    "button-secondary": {
      "border": "{theme.hair-3}",
      "hover-border": "{theme.ink-5}",
      "focus": "2px {primitive.blue.500} offset 2px"
    },
    "nav-link": {
      "default": "{surface.nav.text-muted}",
      "hover": "#FFFFFF",
      "active": "#FFFFFF + inset 0 -2px 0 currentColor"
    },
    "row": {
      "hover-light": "{primitive.surface-light.paper-2}",
      "hover-dark": "{primitive.white-alpha.5}"
    },
    "input": {
      "rest-border": "{theme.hair-3}",
      "hover-border": "{theme.ink-5}",
      "focus": "border {primitive.blue.500} + outline 2px {theme.accent-soft}",
      "error": "{primitive.warn.default}"
    },
    "transition": "background 150ms, border-color 150ms, color 150ms, transform 120ms"
  }
}